# ── Supabase (obbligatorie) — Settings → API del progetto istanza ──
# Solo chiave anonima: MAI service_role nel frontend.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── White-label istanza (opzionali) ─────────────────────────────────
VITE_APP_NAME=FlowCRM
VITE_CLIENTE_NAME=
VITE_LOGO_URL=
VITE_FAVICON_URL=
VITE_PRIMARY_COLOR=#ff5c35
VITE_ACCENT_COLOR=#33475b

# ── Funzionalità ────────────────────────────────────────────────────
VITE_DEMO_MODE=false
VITE_TOUR_ENABLED=false

# ── Moduli verticali acquistati dall'istanza (CSV di slug) ──────────
# Valori possibili: gare, cantiere, automezzi, agenti, poliambulatori.
# La UI mostra solo questi; l'enforcement dati è la licenza nel DB
# (tabella moduli_licenze, scritta dall'installer con service_role).
VITE_MODULES=

# ── Osservabilità (opzionale) ───────────────────────────────────────
VITE_SENTRY_DSN=
