# ═══════════════════════════════════════════════════════════════════
# FlowCRM — ambiente di UNA istanza cliente.
#
# Questo è il TEMPLATE, tracciato in git. Il file reale (.env.prod) lo
# genera onboard-client.sh con segreti casuali, ha chmod 600 e non va
# committato mai. Finisce cifrato dentro il backup: perderlo significa
# perdere JWT_SECRET, e con quello ogni sessione e ogni signed URL emessi.
#
# Si usa insieme ai due compose:
#   docker compose -f supabase-docker/docker-compose.yml \
#                  -f deploy/docker-compose.flowcrm.yml \
#                  --env-file deploy/.env.prod up -d
# ═══════════════════════════════════════════════════════════════════

# ── Istanza ─────────────────────────────────────────────────────────
DOMAIN=acme.flowcrm.it
ACME_EMAIL=ops@flowcrm.it
CLIENTE_NAME=ACME Srl
APP_NAME=FlowCRM

# Versione da eseguire: SEMPRE il GIT_SHA di una build pubblicata su GHCR,
# mai "latest". Con "latest" due istanze aggiornate in giorni diversi
# eseguono codice diverso e non c'è modo di sapere quale.
FLOWCRM_TAG=

# ── Moduli acquistati (CSV) ─────────────────────────────────────────
# Ammessi: gare, cantiere, automezzi, agenti, poliambulatori.
# Vanno attivati ANCHE nel database (INSERT in moduli_licenze): questa
# variabile governa solo cosa mostra il menu, la barriera vera è la RLS.
# Uno slug non riconosciuto ferma l'avvio del container (entrypoint).
MODULES=

# ── Aspetto (facoltativo) ───────────────────────────────────────────
LOGO_URL=/logo-default.svg
FAVICON_URL=/favicon.svg
PRIMARY_COLOR=#ff5c35
ACCENT_COLOR=#33475b
DEMO_MODE=false
TOUR_ENABLED=false

# ── Telemetria (facoltativa, spenta se vuota) ───────────────────────
# DSN del progetto GlitchTip di questa istanza. Vuoto = nessun dato esce
# dal server del cliente: è la risposta da dare a un DPO che obietta.
# SENTRY_ORIGIN entra nella CSP (connect-src): senza, il browser blocca
# l'invio degli errori e la telemetria sembra "non funzionare".
SENTRY_DSN=
SENTRY_ORIGIN=

# ═══════════════════════════════════════════════════════════════════
# Da qui in giù: variabili dello stack Supabase upstream.
# ═══════════════════════════════════════════════════════════════════

# ── PORTE — leggere prima di modificare ─────────────────────────────
# API_GW_HTTP_PORT è usata SOLO nel mapping delle porte, quindi si può
# legare a loopback: il gateway deve essere raggiungibile da Caddy (che è
# sulla stessa rete Docker), mai da Internet.
API_GW_HTTP_PORT=127.0.0.1:8000
#
# POSTGRES_PORT invece NON va toccata: oltre al mapping è usata in dieci
# punti come porta INTERNA (GOTRUE_DB_DATABASE_URL, PGRST_DB_URI, PGPORT…).
# Metterci "127.0.0.1:5432" produrrebbe stringhe di connessione corrotte e
# l'intero stack non parte. Postgres non resta esposto lo stesso perché il
# servizio che pubblicava quella porta (supavisor) non viene avviato — vedi
# la nota in deploy/docker-compose.flowcrm.yml.
POSTGRES_PORT=5432
POSTGRES_HOST=db
POSTGRES_DB=postgres
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_TENANT_ID=flowcrm
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# ── Segreti: generati da onboard-client.sh, UNICI per istanza ───────
# Riusare gli stessi fra due clienti significa che un token di uno vale
# sull'istanza dell'altro.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# ── URL pubblici ────────────────────────────────────────────────────
# Caddy serve applicazione e Supabase sulla STESSA origine: non c'è un
# dominio separato per l'API, ed è ciò che tiene la CSP a 'self'.
SUPABASE_PUBLIC_URL=https://acme.flowcrm.it
API_EXTERNAL_URL=https://acme.flowcrm.it
SITE_URL=https://acme.flowcrm.it
ADDITIONAL_REDIRECT_URLS=

# ── Autenticazione ──────────────────────────────────────────────────
# Il signup pubblico resta SPENTO: gli utenti li crea l'admin del cliente
# dalla pagina Utenti (Edge Function crea-utente). Un signup aperto su un
# CRM aziendale è un difetto, non una comodità.
# ATTENZIONE ALLA COPPIA: i due nomi ingannano.
#   DISABLE_SIGNUP      → GOTRUE_DISABLE_SIGNUP: blocca l'AUTO-REGISTRAZIONE.
#                         È quello che vogliamo spento su un CRM aziendale.
#   ENABLE_EMAIL_SIGNUP → GOTRUE_EXTERNAL_EMAIL_ENABLED: accende o spegne
#                         l'INTERO PROVIDER EMAIL, quindi anche il LOGIN.
# Metterla a false sembra logico ("niente registrazione via email") e invece
# rende l'istanza inaccessibile a chiunque: ogni tentativo di accesso torna
# 422 email_provider_disabled. Deve restare TRUE.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600

# ── Posta (recupero password, inviti) ───────────────────────────────
# La casella arriva CON IL DOMINIO Hostinger: nessun fornitore esterno,
# nessuna seconda fattura, e la giurisdizione è già UE (Hostinger è lituana).
# È la stessa configurazione di WhistleVault in produzione.
#
#   host   smtp.hostinger.com : 587
#   utente ops@<dominio>              (casella creata dal pannello Email)
#   from   no-reply@<dominio>         (alias della stessa casella)
#
# ⚠️ SENZA QUESTE VARIABILI LE MAIL NON PARTONO E NESSUNO SE NE ACCORGE:
# il default è `localhost`, quindi l'invio fallisce in silenzio e il difetto
# si scopre quando un utente chiede il recupero password e non arriva niente.
# In WhistleVault queste variabili esistono ma NON sono documentate in nessun
# runbook: chi installa deve indovinarle. Qui sono nel template e nel §7 del
# RUNBOOK proprio per questo.
#
# ⚠️ CREDENZIALI DISTINTE PER ISTANZA, non la stessa casella per tutti: una
# VPS compromessa manderebbe posta a nome del dominio di ogni altro cliente e
# brucerebbe la reputazione del mittente per l'intera flotta.
#
# Prima del go-live verificare che SPF, DKIM e DMARC risultino PASS: senza
# DKIM i messaggi finiscono nello spam, e la prova del recupero password
# fallisce per una ragione che non sembra tecnica.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=FlowCRM
MAILER_URLPATHS_CONFIRMATION=/auth/conferma
MAILER_URLPATHS_INVITE=/auth/invito
MAILER_URLPATHS_RECOVERY=/auth/recupero
MAILER_URLPATHS_EMAIL_CHANGE=/auth/cambio-email

# ── PostgREST ───────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# ── Edge Functions ──────────────────────────────────────────────────
# false = ogni funzione decide da sé. `health` deve restare raggiungibile
# senza JWT (una sonda di uptime non ne ha uno); tutte le altre validano
# il chiamante nel proprio codice.
FUNCTIONS_VERIFY_JWT=false

# ── Studio (solo rete interna, mai pubblicato) ──────────────────────
STUDIO_DEFAULT_ORGANIZATION=FlowCRM
STUDIO_DEFAULT_PROJECT=acme
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
IMGPROXY_AUTO_WEBP=true

# ── Variabili upstream non usate da questa installazione ────────────
# Vanno dichiarate comunque: senza, `docker compose config` avverte a ogni
# comando e gli avvisi veri si perdono nel rumore. Vuote è corretto:
# lo Storage usa il backend su file, non S3, e Studio non usa OpenAI.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STORAGE_TENANT_ID=flowcrm
GLOBAL_S3_BUCKET=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
REGION=eu-central-1
OPENAI_API_KEY=
